{
  "name": "sim-intelliegence-world",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "tar": "7.5.22"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "dev:harness": "npm run export:web && npm run build:electron && tsx scripts/electron/run-dev-harness.ts",
    "content:build": "tsx scripts/content/build-production-content.ts",
    "content:check": "npm run content:build && git diff --exit-code -- content tests/fixtures/saves/valid-v5-envelope.json tests/fixtures/saves/stale-v6-envelope.json src/ai/registry/generated-browser-writing.ts src/domain/state/generated-layout.ts src/world/transfers/generated-routes.ts",
    "validate:content": "tsx scripts/content/validate-content.ts",
    "check:boundaries": "tsx scripts/verification/check-import-boundaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "model:build": "tsx scripts/model/build-llama.ts",
    "model:manifest": "tsx scripts/model/hash-manifest.ts",
    "model:prepare": "tsx scripts/model/prepare-model.ts",
    "model:parent-kill-smoke": "tsx scripts/model/run-package-parent-kill-smoke.ts",
    "model:real-spike": "tsx scripts/model/run-real-spike.ts",
    "model:qualify": "tsx scripts/qualification/run-model-qualification.ts",
    "model:qualify:verbal": "tsx scripts/qualification/run-verbal-mission-spike.ts",
    "save:qualify": "tsx scripts/qualification/write-save-evidence.ts",
    "qualify:renderer": "tsx scripts/qualification/compare-renderer-frames.ts",
    "capture:2d-baseline": "tsx scripts/verification/capture-2d-baseline.ts",
    "capture:yaw-comparison": "tsx scripts/verification/capture-yaw-comparison.ts",
    "measure:25d-draw-calls": "tsx scripts/verification/measure-25d-draw-calls.ts",
    "capture:art04-25d": "tsx scripts/verification/capture-art04-25d.ts",
    "model:smoke": "tsx scripts/model/run-package-model-smoke.ts",
    "art:atlas": "tsx scripts/art/build-world-atlas.ts && tsx scripts/art/write-protagonist-dialogue-portrait.ts",
    "art:baseline": "tsx scripts/art/write-pixel-baseline.ts",
    "art:crayon": "tsx scripts/art/build-crayon-tile.ts",
    "art:review": "tsx scripts/art/build-art-quality-review.ts",
    "art:qualify:final": "tsx scripts/qualification/write-art-quality-final-manifest.ts",
    "art:check": "npm run art:atlas && tsx scripts/art/check-generated-art.ts",
    "audio:build": "tsx scripts/audio/build-vocal-cues.ts",
    "audio:check": "npm run audio:build && git diff --exit-code -- assets/generated/audio",
    "verify:first-hour": "tsx scripts/verification/run-first-hour-golden.ts",
    "export:web": "expo export --platform web",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package:electron": "npm run export:web && npm run build:electron && electron-forge package",
    "package:mac:arm64": "npm run export:web && npm run build:electron && electron-forge package --platform=darwin --arch=arm64",
    "package:mac:x64": "npm run export:web && npm run build:electron && electron-forge package --platform=darwin --arch=x64",
    "package:windows:x64": "npm run export:web && npm run build:electron && electron-forge package --platform=win32 --arch=x64",
    "sign:test:mac": "tsx scripts/qualification/sign-macos-test.ts",
    "test:electron:unit": "jest --runInBand --runTestsByPath tests/electron/security.test.ts tests/electron/package-smoke.test.ts tests/electron/conversation-ipc.test.ts",
    "test:model": "jest --runInBand --runTestsByPath src/ai/__tests__/spike-response.test.ts tests/electron/model-lifecycle.test.ts",
    "smoke:electron": "tsx scripts/electron/run-package-smoke.ts",
    "smoke:natural-movement": "tsx scripts/electron/run-natural-movement-package-smoke.ts",
    "smoke:art-quality": "tsx scripts/electron/run-art-quality-package-smoke.ts",
    "smoke:procedural-vfx": "tsx scripts/electron/run-procedural-vfx-package-smoke.ts",
    "verify:25d-click": "tsx scripts/verification/verify-25d-click.ts",
    "verify:25d-pan": "tsx scripts/verification/verify-25d-pan.ts",
    "smoke:day-sweep": "tsx scripts/electron/run-day-sweep-smoke.ts",
    "smoke:25d:lit": "tsx scripts/electron/run-25d-shadow-smoke.ts --lit",
    "smoke:25d:fallback": "tsx scripts/electron/run-25d-shadow-smoke.ts --fallback",
    "smoke:responsive": "tsx scripts/electron/run-responsive-package-smoke.ts",
    "smoke:responsive:high-dpi": "tsx scripts/electron/run-responsive-package-smoke.ts --high-dpi",
    "smoke:responsive:qualification": "tsx scripts/electron/run-responsive-package-smoke.ts --high-dpi --qualification",
    "smoke:presentation-restart": "tsx scripts/electron/run-presentation-restart-package-smoke.ts",
    "smoke:save-migration": "tsx scripts/electron/run-save-migration-package-smoke.ts",
    "verify:phase22:packaged": "npm run smoke:responsive && npm run smoke:responsive:qualification && npm run smoke:presentation-restart && npm run smoke:save-migration",
    "test:electron": "npm run test:electron:unit && npm run package:electron && npm run smoke:electron && npm run smoke:natural-movement",
    "verify:ci-build": "npm run content:check && npm run validate:content && npm run art:check && npm run audio:check && npm run verify:first-hour && npm run check:boundaries && npm run typecheck && npm test && npm run export:web && npm run test:electron:unit && npm run test:model",
    "verify": "npm run content:check && npm run validate:content && npm run art:check && npm run audio:check && npm run verify:first-hour && npm run check:boundaries && npm run typecheck && npm test && npm run export:web && npm run test:electron:unit && npm run test:model && npm run smoke:25d:fallback && npm run smoke:25d:lit && npm run package:electron && npm run smoke:electron && npm run smoke:natural-movement && npm run verify:phase22:packaged",
    "spike:threejs:check": "node spikes/001-threejs-pixel-villa/verify.mjs",
    "spike:animated-sketch:build": "esbuild spikes/002-threejs-animated-sketch/scene.js --bundle --format=iife --minify --outfile=spikes/002-threejs-animated-sketch/scene.bundle.js",
    "spike:animated-sketch:check": "npm run spike:animated-sketch:build && node spikes/002-threejs-animated-sketch/verify.mjs",
    "capture:renderer": "tsx scripts/electron/run-renderer-capture.ts",
    "capture:refresh": "tsx scripts/qualification/refresh-candidate-captures.ts",
    "qualify:renderer:sets": "tsx scripts/qualification/qualify-renderer-sets.ts",
    "capture:rebaseline": "tsx scripts/qualification/rebaseline-renderer-captures.ts",
    "capture:promote": "tsx scripts/qualification/promote-renderer-baseline.ts",
    "capture:masks": "tsx scripts/qualification/emit-mask-frames.ts",
    "capture:lights": "tsx scripts/qualification/author-light-samples.ts"
  },
  "dependencies": {
    "@expo-google-fonts/silkscreen": "0.4.2",
    "@expo/metro-runtime": "57.0.8",
    "expo": "57.0.11",
    "expo-asset": "57.0.9",
    "expo-audio": "57.0.3",
    "expo-font": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/three": "0.185.4",
    "electron": "43.3.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.3",
    "pngjs": "7.0.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
